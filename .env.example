# ---- Bază de date (Supabase Postgres, prin pooler IPv4) ----
# Supabase → Connect → foloseste pooler-ul (aws-1-<regiune>.pooler.supabase.com:6543).
DATABASE_URL=postgresql://postgres.<ref>:<parola>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# ---- Autentificare (NextAuth) ----
# Generează cu: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3002

# ---- Supabase Storage (fotografii mașini) ----
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Instagram (postare automată prin Graph API) ----
# Necesită cont Instagram Business legat de o pagină Facebook + aplicație Meta.
# Obține-le cu: node -r dotenv/config scripts/ig-setup.mjs dotenv_config_path=.env.local
IG_ACCESS_TOKEN=
IG_USER_ID=

# Doar pentru scriptul de obținere a tokenului de lungă durată (nu sunt folosite de aplicație):
IG_APP_ID=
IG_APP_SECRET=
IG_SHORT_TOKEN=

# ---- Notificări Telegram (opțional) ----
# Creează un bot cu @BotFather → TELEGRAM_BOT_TOKEN.
# Adaugă botul în grupul/chat-ul dorit și pune id-ul chat-ului în TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Cron (alerte zilnice) ----
# Setează o valoare secretă; Vercel Cron o trimite automat ca Authorization.
CRON_SECRET=
