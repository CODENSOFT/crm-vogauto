
# ——— Telegram ———
# Bot creat cu @BotFather. Folosit pentru notificări ȘI pentru comenzi
# (creare sarcini scriind botului în chat privat).
TELEGRAM_BOT_TOKEN=
# Username-ul botului, fără @ (doar pentru linkul afișat în CRM).
TELEGRAM_BOT_USERNAME=
# Secret aleator; Telegram îl trimite înapoi la fiecare mesaj, ca nimeni
# altcineva să nu poată apela webhook-ul. Generează cu:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Canal unic pentru notificările automate (opțional, separat de comenzi).
TELEGRAM_CHAT_ID=
# Fusul orar pentru „mâine la 10" (implicit Europe/Chisinau).
APP_TIMEZONE=Europe/Chisinau

# ——— WordPress (publicarea anunțurilor pe site) ———
# Adresa site-ului, fără bară la final.
WP_URL=
# Utilizatorul din WordPress (cu drept de publicare).
WP_USER=
# Application Password: WordPress → Utilizatori → Profil → Application Passwords.
# Se poate revoca oricând, fără să schimbi parola contului.
WP_APP_PASSWORD=
# Categoria în care intră anunțurile (opțional, id numeric).
WP_CATEGORY_ID=

# ——— Șablonul de descriere (credit/leasing) ———
# Rata lunară = preț × acest coeficient (0.021 ≈ 735 € la 34 999 €).
FINANCE_MONTHLY_RATE=0.021
FINANCE_MAX_MONTHS=60
COMPANY_STOCK_URL=https://vogauto.md/
COMPANY_ADDRESS=or.Chișinău str.Lunca Bîcului 21
COMPANY_MAP_URL=https://g.co/kgs/bsPo7GB

# ——— Facebook (postare pe pagina companiei) ———
# Id-ul paginii și un Page Access Token cu pages_manage_posts.
# Se obțin din aceeași aplicație Meta folosită pentru Instagram.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ——— Contactul din anunțurile de pe rețele ———
COMPANY_PHONE=
COMPANY_CONTACT_NAME=
COMPANY_EMAIL=
# Avansul cerut, ca fracțiune din preț (0 = „fără prima rată").
FINANCE_DOWN_PAYMENT_RATE=0
